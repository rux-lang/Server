POSTGRES_DB=registry
POSTGRES_USER=registry
POSTGRES_PASSWORD=registry
POSTGRES_PORT=5432
MINIO_ROOT_USER=registry
MINIO_ROOT_PASSWORD=registry-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=packages

RUX_BIND_ADDRESS=127.0.0.1:8080
RUX_DATABASE_URL=postgres://registry:registry@localhost:5432/registry
RUX_STORAGE_ENDPOINT=http://localhost:9000
RUX_STORAGE_BUCKET=packages
RUX_STORAGE_ACCESS_KEY=registry
RUX_STORAGE_SECRET_KEY=registry-secret
RUX_STORAGE_REGION=us-east-1
RUX_STORAGE_FORCE_PATH_STYLE=true
RUX_PACKAGE_CDN_BASE_URL=http://localhost:9000/packages/
RUX_ORPHAN_CLEANUP_INTERVAL_SECONDS=3600
RUX_ORPHAN_CLEANUP_MIN_AGE_SECONDS=86400
RUX_ORPHAN_CLEANUP_SCAN_LIMIT=1000
RUX_ORPHAN_CLEANUP_DELETE_LIMIT=100
RUX_ALLOWED_WEB_ORIGIN=http://localhost:3000
RUX_WEB_CALLBACK_URL=http://localhost:3000/packages/-/auth/callback
RUX_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
RUX_GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
RUX_GITHUB_CALLBACK_URL=http://localhost:8080/v1/auth/github/callback
RUX_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
RUX_REQUEST_TIMEOUT_SECONDS=30
RUX_PUBLICATION_TIMEOUT_SECONDS=120
RUX_RATE_LIMIT_READ_PER_MINUTE=120
RUX_RATE_LIMIT_READ_BURST=60
RUX_RATE_LIMIT_SECURITY_PER_MINUTE=30
RUX_RATE_LIMIT_SECURITY_BURST=10
RUX_RATE_LIMIT_MUTATION_PER_MINUTE=60
RUX_RATE_LIMIT_MUTATION_BURST=20
RUX_RATE_LIMIT_PUBLICATION_PER_MINUTE=6
RUX_RATE_LIMIT_PUBLICATION_BURST=2
RUX_RATE_LIMIT_PLAYGROUND_PER_MINUTE=10
RUX_RATE_LIMIT_PLAYGROUND_BURST=4
RUX_UPLOAD_TEMPORARY_DIRECTORY=
RUX_UPLOAD_TEMPORARY_CAPACITY_BYTES=104857600
RUX_UPLOAD_MAX_CONCURRENCY=8
# The playground needs rux-playgroundd running on the socket below; leaving it
# disabled makes the endpoints a 404 rather than a 503.
RUX_PLAYGROUND_ENABLED=false
RUX_PLAYGROUND_SOCKET=/run/rux-playground/run.sock
RUX_PLAYGROUND_TIMEOUT_SECONDS=30
RUX_PLAYGROUND_MAX_CONCURRENCY=2
RUX_METRICS_BIND_ADDRESS=127.0.0.1:9464
RUX_METRICS_ALLOW_NON_LOOPBACK=false
RUX_DEPENDENCY_PROBE_INTERVAL_SECONDS=15
RUST_LOG=info,rux_server=debug
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=rux-server
