[Unit]
Description=Rux Server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
ConditionPathIsExecutable=/srv/rux-server/current/bin/rux-server

[Service]
Type=simple
User=rux-server
Group=rux-server
WorkingDirectory=/srv/rux-server/current
EnvironmentFile=/etc/rux-server/api.env
ExecStart=/srv/rux-server/current/bin/rux-server
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rux-server/uploads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
