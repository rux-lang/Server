#!/usr/sbin/nft -f

# Replace only the table this file owns. `flush ruleset` would also delete the
# tables a container runtime installs, so reloading the host firewall would
# silently drop rules this file never wrote. The bare `table` line creates the
# table when it is absent, so the `delete` below always has a target and the
# whole reload stays atomic.
table inet rux_filter
delete table inet rux_filter

table inet rux_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state invalid drop
    ct state established,related accept
    iifname "lo" accept

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

{% for cidr in rux_ssh_allowed_cidrs %}
{% if ':' in cidr %}
    ip6 saddr {{ cidr }} tcp dport {{ rux_ssh_port }} ct state new accept
{% else %}
    ip saddr {{ cidr }} tcp dport {{ rux_ssh_port }} ct state new accept
{% endif %}
{% endfor %}
    tcp dport { 80, 443 } ct state new accept
    udp dport 443 ct state new accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
