global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rux-alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 127.0.0.1:9093

scrape_configs:
  - job_name: rux-server
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:9464

  - job_name: rux-node
    static_configs:
      - targets:
          - 127.0.0.1:9100
