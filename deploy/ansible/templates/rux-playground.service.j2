{#
  The playground broker: the only process on this host allowed to reach the
  Docker socket.

  Why this unit is deliberately weaker than rux-server.service.j2
  ---------------------------------------------------------------
  Docker's socket is root-equivalent. That is the entire reason the playground
  is a second service under a second user instead of a module inside the API:
  the registry keeps RestrictNamespaces=true, an empty CapabilityBoundingSet and
  ProtectSystem=strict over its database and package artifacts, and never gains
  docker group membership.

  Hardening this unit therefore cannot be what contains a compromise - anything
  that can talk to the socket can already ask the daemon to do root's work. What
  contains a run is the container flag set the sandbox passes (--network=none, a
  read-only root, dropped capabilities, pid and memory limits), which lives in
  crates/sandbox and is unit-tested there. The flags below are defence in depth
  for the broker process itself, and the two that would fight the docker CLI are
  omitted rather than pretended:

    - RestrictNamespaces is absent. The registry sets it; here it is left off
      because the CLI's exec path into the daemon is not audited against it.
    - ProtectSystem=strict is kept, but /run/docker.sock is listed read-write.
      Connecting to a unix socket is a write, so a strict filesystem without
      this line would break every run.
#}
[Unit]
Description=Rux Playground sandbox broker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionFileIsExecutable=/srv/rux-server/current/bin/rux-playgroundd

[Service]
Type=simple
User=rux-playground
Group=rux-playground
SupplementaryGroups=docker
WorkingDirectory=/var/lib/rux-playground
EnvironmentFile=/etc/rux-playground/playground.env
ExecStart=/srv/rux-server/current/bin/rux-playgroundd
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths={{ playground_state_root }} {{ playground_runtime_directory }} /run/docker.sock
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
